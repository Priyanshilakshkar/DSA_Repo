class Solution {
    public ListNode reverseKGroup(ListNode head, int k) {
          int size = 0;
          ListNode temp = head;

          while(temp != null){
            size++;
            temp = temp.next;
          }


          int n = size/k;

          ListNode current = head;
          ListNode next = null;
        
          ListNode newHead = head;
          ListNode tail = null;

          for(int i=0 ; i<n ; i++){
             int count = 0;
             ListNode groupStart = current;
             ListNode prev = null;
             while(count<k){
                 ListNode next1 = current.next;

                 current.next = prev;
                 prev = current;
                 current = next1;

                 count++;
             }
             if (tail == null) newHead = prev;
                  else tail.next = prev;

                  groupStart.next = current;
                  tail = groupStart;
          }

          return newHead == null ? head : newHead;

    }
}
